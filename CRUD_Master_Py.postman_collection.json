{
  "info": {
    "_postman_id": "d4e5f6a7-b8c9-40d1-a2e3-f4a5b6c7d8e9",
    "name": "Play with Containers - Gateway and Messaging Audit",
    "description": "Ordered audit collection for the public API Gateway and the manual billing-queue resilience test. Run folder 1 normally. Run folder 2 only after scaling billing-app to zero as described in that folder.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "gatewayUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "gateway_movie_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "baseline_user_id",
      "value": "20",
      "type": "string"
    },
    {
      "key": "queued_user_id",
      "value": "22",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. API Gateway and Billing Baseline",
      "description": "Run this folder with every application pod running. It exercises the movie API and publishes the baseline billing order for user 20. Note: request 9 intentionally deletes every inventory movie as required by the CRUD audit.",
      "item": [
        {
          "name": "1. Create Movie Through Gateway",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201', function () { pm.response.to.have.status(201); });",
                  "pm.test('Created movie is returned and its ID is saved', function () {",
                  "    const data = pm.response.json();",
                  "    pm.expect(data).to.have.property('id');",
                  "    pm.expect(data.title).to.eql('Postman Gateway Audit Movie');",
                  "    pm.expect(data.description).to.eql('Created through the Gateway');",
                  "    pm.collectionVariables.set('gateway_movie_id', data.id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Postman Gateway Audit Movie\",\n  \"description\": \"Created through the Gateway\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{gatewayUrl}}/api/movies/"
          }
        },
        {
          "name": "2. Get All Movies Through Gateway",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Response contains the created movie', function () {",
                  "    const data = pm.response.json();",
                  "    const id = Number(pm.collectionVariables.get('gateway_movie_id'));",
                  "    pm.expect(data).to.be.an('array');",
                  "    pm.expect(data.some(movie => movie.id === id)).to.be.true;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{gatewayUrl}}/api/movies/"
          }
        },
        {
          "name": "3. Filter Movies By Title Through Gateway",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Every result matches the title filter', function () {",
                  "    const data = pm.response.json();",
                  "    pm.expect(data).to.be.an('array').that.is.not.empty;",
                  "    data.forEach(movie => pm.expect(movie.title.toLowerCase()).to.include('gateway audit'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{gatewayUrl}}/api/movies?title=Gateway%20Audit"
          }
        },
        {
          "name": "4. Get Movie By ID Through Gateway",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Returned movie ID matches the saved ID', function () {",
                  "    const data = pm.response.json();",
                  "    pm.expect(String(data.id)).to.eql(String(pm.collectionVariables.get('gateway_movie_id')));",
                  "    pm.expect(data.title).to.eql('Postman Gateway Audit Movie');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{gatewayUrl}}/api/movies/{{gateway_movie_id}}"
          }
        },
        {
          "name": "5. Update Movie By ID Through Gateway",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Movie fields are updated', function () {",
                  "    const data = pm.response.json();",
                  "    pm.expect(data.title).to.eql('Postman Gateway Audit Movie Updated');",
                  "    pm.expect(data.description).to.eql('Updated through the Gateway');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Postman Gateway Audit Movie Updated\",\n  \"description\": \"Updated through the Gateway\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{gatewayUrl}}/api/movies/{{gateway_movie_id}}/"
          }
        },
        {
          "name": "6. Delete Movie By ID Through Gateway",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Deletion confirmation is returned', function () {",
                  "    pm.expect(pm.response.json().message).to.include('deleted successfully');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{gatewayUrl}}/api/movies/{{gateway_movie_id}}"
          }
        },
        {
          "name": "7. Confirm Deleted Movie Returns 404 Through Gateway",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 404', function () { pm.response.to.have.status(404); });",
                  "pm.test('Inventory error is preserved', function () {",
                  "    pm.expect(pm.response.json().error).to.eql('Movie not found');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{gatewayUrl}}/api/movies/{{gateway_movie_id}}"
          }
        },
        {
          "name": "8. Create Movie For Gateway Delete-All Test",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201', function () { pm.response.to.have.status(201); });",
                  "pm.test('Cleanup movie is created', function () {",
                  "    const data = pm.response.json();",
                  "    pm.expect(data).to.have.property('id');",
                  "    pm.expect(data.title).to.eql('Postman Gateway Delete All Movie');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Postman Gateway Delete All Movie\",\n  \"description\": \"Temporary cleanup record\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{gatewayUrl}}/api/movies"
          }
        },
        {
          "name": "9. Delete All Movies Through Gateway",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Delete-all confirmation is preserved', function () {",
                  "    pm.expect(pm.response.json().message).to.match(/^Successfully deleted all [1-9][0-9]* movies[.]$/);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{gatewayUrl}}/api/movies/"
          }
        },
        {
          "name": "10. Confirm Gateway Inventory Is Empty",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Response is an empty array', function () {",
                  "    pm.expect(pm.response.json()).to.eql([]);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{gatewayUrl}}/api/movies"
          }
        },
        {
          "name": "11. Queue Baseline Billing Order (User 20)",
          "description": "Publishes the baseline order while billing-app is running. After it succeeds, verify it was consumed with: kubectl exec billing-db-0 -- psql -U appuser -d billing_db -c \"SELECT * FROM orders WHERE user_id = '20';\"",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Queue confirmation is returned', function () {",
                  "    pm.expect(pm.response.json().message).to.eql('Message posted');",
                  "});",
                  "pm.test('Audit baseline user is 20', function () {",
                  "    const body = JSON.parse(pm.variables.replaceIn(pm.request.body.raw));",
                  "    pm.expect(String(body.user_id)).to.eql(pm.collectionVariables.get('baseline_user_id'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": \"{{baseline_user_id}}\",\n  \"number_of_items\": \"99\",\n  \"total_amount\": \"250\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{gatewayUrl}}/api/billing/"
          }
        }
      ]
    },
    {
      "name": "2. Messaging Queue Resilience (Manual Gate)",
      "description": "Do not run this folder as part of the normal collection run. Audit sequence: (1) confirm user 20 exists in billing_db; (2) stop the consumer with `kubectl scale statefulset billing-app --replicas=0` and wait for billing-app-0 to terminate; (3) run the request in this folder; (4) confirm user 22 is NOT yet in `orders`; (5) restart it with `kubectl scale statefulset billing-app --replicas=1`; (6) wait for billing-app-0 to become Ready, then confirm user 22 appears. This proves RabbitMQ retained the message while the consumer was unavailable.",
      "item": [
        {
          "name": "12. Queue Resilience Billing Order (User 22)",
          "description": "PRECONDITION: billing-app must be scaled to 0 before sending this request. A 200 response proves the gateway can publish while the consumer is stopped. Before restarting billing-app, run: kubectl exec billing-db-0 -- psql -U appuser -d billing_db -c \"SELECT * FROM orders WHERE user_id = '22';\" and confirm zero rows. After scaling billing-app back to 1, repeat the query and confirm the order appears.",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Queue confirmation is returned', function () {",
                  "    pm.expect(pm.response.json().message).to.eql('Message posted');",
                  "});",
                  "pm.test('Audit resilience user is 22', function () {",
                  "    const body = JSON.parse(pm.variables.replaceIn(pm.request.body.raw));",
                  "    pm.expect(String(body.user_id)).to.eql(pm.collectionVariables.get('queued_user_id'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": \"{{queued_user_id}}\",\n  \"number_of_items\": \"5\",\n  \"total_amount\": \"125\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{gatewayUrl}}/api/billing/"
          }
        }
      ]
    }
  ]
}
